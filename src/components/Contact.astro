---
import { Mail, Phone } from '@lucide/astro';
import { site } from '../data/site';
---

<section class="px-5 pb-8">
  <div class="mx-auto max-w-4xl rounded-box bg-neutral px-6 py-12 text-center text-neutral-content md:px-12 md:py-16">
    <h2 class="text-4xl font-semibold md:text-5xl">Let's talk boats.</h2>
    <p class="mx-auto mt-4 max-w-lg text-lg opacity-85">Get in touch for a quote, or just to talk about boats.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={`tel:${site.phone}`} class="btn btn-lg btn-primary">
        <Phone size={20} aria-hidden="true" />
        {site.phone}
      </a>
      <a href={`mailto:${site.email}`} class="btn border-white/40 bg-transparent text-white btn-lg hover:bg-white/10">
        <Mail size={20} aria-hidden="true" />
        <span class="break-all">{site.email}</span>
      </a>
    </div>
  </div>
</section>
