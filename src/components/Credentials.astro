---
import { Anchor, BadgeCheck, MessagesSquare } from '@lucide/astro';

const items = [
  { icon: BadgeCheck, text: 'Licensed in the city of Santa Barbara' },
  { icon: MessagesSquare, text: 'Referrals available upon request' },
  { icon: Anchor, text: 'Trusted local vendors in Santa Barbara and Ventura' },
];
---

<section class="mx-auto w-full max-w-6xl px-5 pb-16 md:px-8">
  <ul class="grid gap-6 border-t border-base-300 pt-10 md:grid-cols-3">
    {
      items.map(({ icon: Icon, text }) => (
        <li class="flex items-center gap-3 text-lg font-medium">
          <Icon size={26} class="shrink-0 text-secondary" aria-hidden="true" />
          {text}
        </li>
      ))
    }
  </ul>
</section>
