---
import { Camera } from '@lucide/astro';

interface Props {
  /** Image path, e.g. /images/photos/haul-out.jpg. Leave empty to show a placeholder. */
  src?: string;
  alt: string;
  /** Short handwritten-style caption under the photo. */
  caption?: string;
  /** Tailwind aspect-ratio class for the photo area. */
  aspect?: string;
  class?: string;
}

const { src, alt, caption, aspect = 'aspect-[4/3]', class: className } = Astro.props;
// Root-relative paths are under the site base (a subpath on the github.io URL)
const imgSrc = src?.startsWith('/') ? `${import.meta.env.BASE_URL}${src.slice(1)}` : src;
---

<figure class:list={['rounded-sm bg-white p-2.5 pb-3 shadow-lg shadow-base-content/10', className]}>
  {
    src ? (
      <img class:list={['w-full rounded-[2px] object-cover', aspect]} src={imgSrc} alt={alt} loading="lazy" />
    ) : (
      <div
        class:list={[
          'placeholder-stripes flex w-full flex-col items-center justify-center gap-2 rounded-[2px] text-base-content/50',
          aspect,
        ]}
        role="img"
        aria-label={`Photo coming soon: ${alt}`}
      >
        <Camera size={28} aria-hidden="true" />
        <span class="px-4 text-center text-xs font-medium tracking-wide uppercase">{alt}</span>
      </div>
    )
  }
  {caption && <figcaption class="pt-2.5 text-center font-display text-sm italic">{caption}</figcaption>}
</figure>

<style>
  .placeholder-stripes {
    background: repeating-linear-gradient(
      -45deg,
      var(--color-base-200),
      var(--color-base-200) 10px,
      var(--color-base-300) 10px,
      var(--color-base-300) 11px
    );
  }
</style>
