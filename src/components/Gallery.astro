---
import PhotoSlot from './PhotoSlot.astro';

// Add a `src` (e.g. '/images/photos/haul-out.webp') to an entry to swap in a real photo.
const photos = [
  {
    src: '/images/photos/engine-room-generator.webp',
    alt: 'Engine and generator in an engine room',
    caption: 'Engine day',
    class: '-rotate-2',
  },
  {
    src: '/images/photos/boat-on-the-hard.webp',
    alt: 'A sailboat in the lift at a local boat yard',
    caption: 'Haul out',
    class: 'rotate-1 md:mt-8',
  },
  {
    src: '/images/photos/fitting-bow-furler.webp',
    alt: 'Fitting a roller furler at the bow',
    caption: 'Rigging',
    class: '-rotate-1',
  },
  {
    src: '/images/photos/sloop-under-sail-sb-channel.webp',
    alt: 'A sloop under sail off Santa Barbara',
    caption: 'Delivery up the coast',
    class: 'rotate-2 md:mt-8',
  },
];
---

<section class="overflow-hidden bg-base-200">
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
    <h2 class="text-4xl font-semibold md:text-5xl">From the logbook</h2>
    <p class="mt-4 max-w-xl text-lg text-base-content/80">A few snapshots from around the harbor.</p>
    <div class="mt-10 grid grid-cols-2 gap-5 md:grid-cols-4 md:gap-8">
      {photos.map((photo) => <PhotoSlot {...photo} aspect="aspect-square" />)}
    </div>
  </div>
</section>
