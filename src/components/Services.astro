---
import { Compass, Hammer, Wrench } from '@lucide/astro';

const groups = [
  {
    title: 'Routine maintenance',
    icon: Wrench,
    items: [
      'Management of regular engine and generator maintenance',
      'Outboard and dinghy maintenance',
      'Fueling',
      'Holding tank emptying',
      'Regular checking of thru-hulls, bilge pumps, fluid levels, filters, strainers, etc',
      'Pre and post trip boat checks',
    ],
  },
  {
    title: 'Repairs & projects',
    icon: Hammer,
    items: [
      'Light repairs of fiberglass, electronics, plumbing, wood work and rigging',
      'Working with local vendors on large projects for electronics, rigging, stainless, brightwork and cleaning',
      'Work with local boat yards (Santa Barbara and Ventura) to ensure successful haul outs',
    ],
  },
  {
    title: 'Deliveries',
    icon: Compass,
    items: ['Available for delivery service on the US west coast', 'Available as crew for deliveries world wide'],
  },
];
---

<section class="mx-auto w-full max-w-6xl px-5 py-16 md:px-8 md:py-24">
  <h2 class="text-4xl font-semibold md:text-5xl">What I can take off your hands</h2>
  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {
      groups.map(({ title, icon: Icon, items }) => (
        <article class="card bg-white shadow-sm ring-1 ring-base-300">
          <div class="card-body gap-4">
            <span class="grid size-12 place-items-center rounded-full bg-secondary/10 text-secondary">
              <Icon size={24} aria-hidden="true" />
            </span>
            <h3 class="card-title text-2xl">{title}</h3>
            <ul class="space-y-2.5 text-base-content/80">
              {items.map((item) => (
                <li class="flex gap-2.5">
                  <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-current" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>
